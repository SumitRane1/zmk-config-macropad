/*
 * ZMK Keymap — Hand-corrected test version
 * Device        : nice!nano v2 · 3x3 Macropad
 * Content Layers: 0 media, 1 system, 2 illustrator, 3 premiere_pro
 *                 (cycled by FN, via macros -- NOT &to, so overlays survive)
 * Encoder Modes : 4 mode_volume, 5 mode_brightness
 *                 (cycled by encoder push, fully independent of FN)
 *
 * TEST GOAL:
 *   1. Rotate encoder on any content layer -> page scroll.
 *   2. Press encoder -> volume mode. Rotate -> volume changes.
 *   3. Press FN while in volume mode -> content layer switches,
 *      encoder STAYS in volume mode (this is the exact bug we're fixing).
 *   4. Press encoder again -> brightness mode. Press again -> back to scroll.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    macros {
        // ── FN round-robin transitions (replace &to, preserve other layers) ──
        media_to_system: media_to_system {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&tog 0>, <&tog 1>;
        };

        system_to_illustrator: system_to_illustrator {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&tog 1>, <&tog 2>;
        };

        illustrator_to_premiere: illustrator_to_premiere {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&tog 2>, <&tog 3>;
        };

        premiere_to_media: premiere_to_media {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&tog 3>, <&tog 0>;
        };

        // ── Encoder mode transition (unchanged from before) ──
        mode_volume_to_brightness: mode_volume_to_brightness {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&tog 4>, <&tog 5>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        media: layer_0 {
            label = "MEDIA";
            bindings = <
                &kp C_PP               &kp C_PREV             &kp C_NEXT
                &kp C_VOL_UP           &kp C_MUTE             &kp C_VOL_DN
                &kp C_BRI_UP           &kp C_BRI_DN           &kp LG(LS(S))
                &media_to_system       &tog 4
            >;
            sensor-bindings = <&inc_dec_kp PG_DN PG_UP>;
        };

        system: layer_1 {
            label = "SYSTEM";
            bindings = <
                &kp LG(L)              &kp LG(D)              &kp LG(TAB)
                &kp LA(F4)             &kp LG(R)              &kp LG(E)
                &kp LC(LS(ESC))        &kp C_SLEEP            &kp C_AL_CALC
                &system_to_illustrator &tog 4
            >;
            sensor-bindings = <&inc_dec_kp PG_DN PG_UP>;
        };

        illustrator: layer_2 {
            label = "ILLUSTRATOR";
            bindings = <
                &kp LC(Z)              &kp LC(G)              &kp LC(LS(G))
                &kp LC(S)              &kp LC(C)              &kp LC(V)
                &kp LC(LS(RBKT))       &kp LC(EQUAL)          &kp LC(MINUS)
                &illustrator_to_premiere &tog 4
            >;
            sensor-bindings = <&inc_dec_kp PG_DN PG_UP>;
        };

        premiere_pro: layer_3 {
            label = "PREMIERE PRO";
            bindings = <
                &kp SPACE              &kp LC(Z)              &kp LC(K)
                &kp LC(M)              &kp I                  &kp O
                &kp LC(C)              &kp LC(S)              &kp LC(LS(M))
                &premiere_to_media     &tog 4
            >;
            sensor-bindings = <&inc_dec_kp PG_DN PG_UP>;
        };

        mode_volume: layer_4 {
            label = "MODE_VOLUME";
            bindings = <
                &trans                 &trans                 &trans
                &trans                 &trans                 &trans
                &trans                 &trans                 &trans
                &trans                 &mode_volume_to_brightness
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP>;
        };

        mode_brightness: layer_5 {
            label = "MODE_BRIGHTNESS";
            bindings = <
                &trans                 &trans                 &trans
                &trans                 &trans                 &trans
                &trans                 &trans                 &trans
                &trans                 &tog 5
            >;
            sensor-bindings = <&inc_dec_kp C_BRI_DN C_BRI_UP>;
        };
    };
};
